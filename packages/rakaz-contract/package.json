{
  "name": "@rakaz/contract",
  "version": "1.0.0",
  "private": true,
  "description": "Shared linking contract between Rakaz apps, dashboard, and API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.4",
    "typescript": "~5.9.2"
  }
}
